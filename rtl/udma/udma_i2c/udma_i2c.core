name: openhwgroup.org:ip:udma_i2c
description: uDMA I2C interface

filesets:
  files_rtl:
    files:
    - rtl/udma_i2c_reg_if.sv
    - rtl/udma_i2c_bus_ctrl.sv
    - rtl/udma_i2c_control.sv
    - rtl/udma_i2c_status.sv
    - rtl/udma_i2c_top.sv
    file_type: systemVerilogSource
  files_status_test:
    depend:
    - pulp-platform.org::common_cells
    - pulp-platform.org::tech_cells_generic
    files:
    - rtl/udma_i2c_reg_if.sv
    - rtl/udma_i2c_status.sv
    - tb/udma_i2c_status_tb.sv
    file_type: systemVerilogSource
  files_control_status_test:
    files:
    - rtl/udma_i2c_bus_ctrl.sv
    - rtl/udma_i2c_control.sv
    - tb/udma_i2c_control_status_tb.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
    - files_rtl
  status-test:
    default_tool: icarus
    filesets:
    - files_status_test
    toplevel: udma_i2c_status_tb
    tools:
      icarus:
        iverilog_options:
        - -g2012
  control-status-test:
    default_tool: icarus
    filesets:
    - files_control_status_test
    toplevel: udma_i2c_control_status_tb
    tools:
      icarus:
        iverilog_options:
        - -g2012
